function makeFallbackPlayer() {

  const group =
    new THREE.Group();


  const body =
    new THREE.Mesh(

      new THREE.CapsuleGeometry(
        0.55,
        1.3,
        6,
        10
      ),

      makeMat(
        0x313a4f
      )

    );

  body.position.y =
    1.45;


  const head =
    new THREE.Mesh(

      new THREE.SphereGeometry(
        0.45,
        16,
        12
      ),

      makeMat(
        0xd6ab88
      )

    );

  head.position.y =
    2.7;


  group.add(
    body,
    head
  );

  return group;

}


async function loadPlayer() {

  const loaded =
    await tryCandidates([

      "assets/player/player.glb",

      "assets/player/player.gltf",

      "assets/player/player.fbx"

    ]);


  if (loaded) {

    const model =
      normalizeModel(
        loaded.root,
        3.4
      );

    player.add(
      model
    );


    if (
      loaded.animations.length
    ) {

      const mixer =
        new THREE.AnimationMixer(
          loaded.root
        );

      mixer
        .clipAction(
          loaded.animations[0]
        )
        .play();

      mixers.push(
        mixer
      );

    }

  } else {

    player.add(
      makeFallbackPlayer()
    );

    msg(
      "player.glb not found — temporary player loaded."
    );

  }


  player.position.set(

    0,

    terrainHeight(
      0,
      0
    ),

    0

  );

}


/* ==========================================
   LOAD PALS
========================================== */

async function loadPals() {

  for (
    const info of PAL_LIBRARY
  ) {

    const loaded =
      await tryCandidates(
        info.files
      );


    if (!loaded)
      continue;


    normalizeModel(
      loaded.root,
      3.2
    );


    palTemplates.set(

      info.name,

      loaded

    );

  }


  if (
    !palTemplates.size
  ) {

    msg(
      "No Pal models found in assets/pals/."
    );

    return;

  }


  spawnWildPals();

}


/* ==========================================
   SPAWN WILD PALS
========================================== */

function spawnWildPals() {

  const names =
    [...palTemplates.keys()];


  const count =
    Math.min(

      40,

      Math.max(
        14,
        names.length * 2
      )

    );


  for (
    let i = 0;
    i < count;
    i++
  ) {

    const name =
      names[
        i %
        names.length
      ];


    const template =
      palTemplates.get(
        name
      );


    const root =
      cloneSkinned(
        template.root
      );


    root.userData.pal =
      true;


    root.userData.name =
      name;


    root.userData.level =
      1 +
      Math.floor(
        Math.random() * 18
      );


    root.userData.hp =
      100;


    root.userData.maxHp =
      100;


    root.userData.wanderAngle =
      Math.random() *
      Math.PI *
      2;


    const x =
      THREE.MathUtils.randFloatSpread(
        720
      );


    const z =
      THREE.MathUtils.randFloatSpread(
        720
      );


    root.position.set(

      x,

      terrainHeight(
        x,
        z
      ),

      z

    );


    scene.add(
      root
    );


    wildPals.push(
      root
    );


    if (
      template.animations.length
    ) {

      const mixer =
        new THREE.AnimationMixer(
          root
        );

      mixer
        .clipAction(
          template.animations[0]
        )
        .play();

      mixers.push(
        mixer
      );

    }

  }

}


/* ==========================================
   WILD PAL MOVEMENT
========================================== */

function updateWild(
  dt
) {

  for (
    const pal of wildPals
  ) {

    if (
      !pal.parent
    )
      continue;


    pal.userData.wanderAngle +=

      THREE.MathUtils.randFloatSpread(
        0.5
      ) *

      dt;


    const speed =
      0.8 +

      (
        pal.userData.level ||
        1
      ) *

      0.02;


    pal.position.x +=

      Math.cos(
        pal.userData.wanderAngle
      ) *

      speed *

      dt;


    pal.position.z +=

      Math.sin(
        pal.userData.wanderAngle
      ) *

      speed *

      dt;


    pal.position.y =
      terrainHeight(

        pal.position.x,

        pal.position.z

      );


    pal.rotation.y =

      -pal.userData.wanderAngle +

      Math.PI / 2;

  }

}


/* ==========================================
   TARGET SYSTEM
========================================== */

function updateTarget() {

  raycaster.setFromCamera(
    center,
    camera
  );


  const hits =
    raycaster.intersectObjects(
      wildPals,
      true
    );


  let found =
    null;


  for (
    const hit of hits
  ) {

    let object =
      hit.object;


    while (

      object &&

      !object.userData.pal

    ) {

      object =
        object.parent;

    }


    if (

      object?.userData.pal &&

      hit.distance < 34

    ) {

      found =
        object;

      break;

    }

  }


  currentTarget =
    found;


  if (
    !targetCard
  )
    return;


  targetCard.style.display =
    found
      ? "block"
      : "none";


  if (!found)
    return;


  const hpPercent =

    Math.max(
      0,
      found.userData.hp
    ) /

    found.userData.maxHp *

    100;


  const chance =
    captureProbability(
      found
    );


  targetName.textContent =
    found.userData.name;


  targetMeta.textContent =

    `Lv. ${found.userData.level}`;


  captureChance.textContent =

    `${Math.round(
      chance * 100
    )}% capture`;


  targetHpBar.style.width =

    `${hpPercent}%`;

}


/* ==========================================
   CAPTURE CHANCE
========================================== */

function captureProbability(
  pal
) {

  const hpFactor =

    1 -

    pal.userData.hp /

    pal.userData.maxHp;


  return THREE.MathUtils.clamp(

    SPHERES[
      selectedSphere
    ].power *

    (
      0.65 +
      hpFactor *
      0.85
    ),

    0.08,

    0.98

  );

}


/* ==========================================
   ATTACK
========================================== */

function attackTarget() {

  if (
    !currentTarget
  )
    return;


  currentTarget.userData.hp -=

    12 +

    playerState.level *
    1.5;


  if (

    currentTarget.userData.hp <=
    0

  ) {

    msg(

      `${currentTarget.userData.name} was defeated.`

    );


    scene.remove(
      currentTarget
    );


    const index =
      wildPals.indexOf(
        currentTarget
      );


    if (
      index >= 0
    ) {

      wildPals.splice(
        index,
        1
      );

    }


    currentTarget =
      null;

  }

}


/* ==========================================
   SPHERES
========================================== */

function createSphereVisual(
  index
) {

  const colors = [

    0x4da6ff,

    0x52d47b,

    0xe2bd43,

    0xff6d35,

    0xffb02e

  ];


  const sphere =
    new THREE.Mesh(

      new THREE.SphereGeometry(
        0.32,
        18,
        12
      ),

      makeMat(
        colors[index] ||
        0xffffff,
        0.45
      )

    );


  sphere.castShadow =
    true;


  return sphere;

}


/* ==========================================
   THROW SPHERE
========================================== */

function throwSphere() {

  if (
    !currentTarget
  ) {

    msg(
      "Aim at a Pal before throwing a Sphere."
    );

    return;

  }


  const sphere =
    createSphereVisual(
      selectedSphere
    );


  const direction =
    new THREE.Vector3();


  camera.getWorldDirection(
    direction
  );


  sphere.position
    .copy(
      camera.position
    )
    .add(

      direction
        .clone()
        .multiplyScalar(
          1.4
        )

    );


  scene.add(
    sphere
  );


  sphereProjectiles.push({

    mesh:
      sphere,

    velocity:
      direction
        .multiplyScalar(

          18 +
          qCharge * 15

        )
        .add(

          new THREE.Vector3(

            0,

            3 +
            qCharge * 4,

            0

          )

        ),

    target:
      currentTarget,

    life:
      3

  });


  qCharge =
    0;

}


/* ==========================================
   UPDATE SPHERES
========================================== */

function updateSpheres(
  dt
) {

  for (

    let i =
      sphereProjectiles.length - 1;

    i >= 0;

    i--

  ) {

    const projectile =
      sphereProjectiles[i];


    projectile.velocity.y -=
      9.8 *
      dt;


    projectile.mesh.position
      .addScaledVector(

        projectile.velocity,

        dt

      );


    projectile.mesh.rotation.x +=
      dt * 8;


    projectile.life -=
      dt;


    if (

      projectile.target?.parent &&

      projectile.mesh.position
        .distanceTo(

          projectile.target.position
            .clone()
            .add(

              new THREE.Vector3(
                0,
                1.5,
                0
              )

            )

        ) < 2.4

    ) {

      const chance =
        captureProbability(
          projectile.target
        );


      const success =
        Math.random() <
        chance;


      if (success) {

        capturePal(
          projectile.target
        );

      } else {

        msg(

          `${projectile.target.userData.name} escaped the Sphere!`

        );

      }


      scene.remove(
        projectile.mesh
      );


      sphereProjectiles.splice(
        i,
        1
      );


      continue;

    }


    if (
      projectile.life <= 0
    ) {

      scene.remove(
        projectile.mesh
      );


      sphereProjectiles.splice(
        i,
        1
      );

    }

  }

}


/* ==========================================
   CAPTURE PAL
========================================== */

function capturePal(
  pal
) {

  const data = {

    name:
      pal.userData.name,

    level:
      pal.userData.level

  };


  if (
    playerState.party.length < 5
  ) {

    playerState.party.push(
      data
    );

  } else {

    playerState.box.push(
      data
    );

  }


  msg(
    `${data.name} captured!`
  );


  scene.remove(
    pal
  );


  const index =
    wildPals.indexOf(
      pal
    );


  if (
    index >= 0
  ) {

    wildPals.splice(
      index,
      1
    );

  }


  persist();

  renderParty();

}


/* ==========================================
   SUMMON PAL
========================================== */

function summonFirstPal() {

  if (
    playerState.summon
  ) {

    scene.remove(
      playerState.summon
    );

    playerState.summon =
      null;

    return;

  }


  const first =
    playerState.party[0];


  if (!first) {

    msg(
      "Capture a Pal first."
    );

    return;

  }


  const template =
    palTemplates.get(
      first.name
    );


  if (!template)
    return;


  const pal =
    cloneSkinned(
      template.root
    );


  pal.position
    .copy(
      player.position
    )
    .add(

      new THREE.Vector3(
        3,
        0,
        3
      )

    );


  pal.position.y =
    terrainHeight(

      pal.position.x,

      pal.position.z

    );


  scene.add(
    pal
  );


  playerState.summon =
    pal;


  msg(
    `${first.name} summoned.`
  );

}


/* ==========================================
   MOUNT
========================================== */

function toggleMount() {

  if (
    !playerState.summon
  ) {

    msg(
      "Summon a Pal with F first."
    );

    return;

  }


  playerState.mounted =
    !playerState.mounted;


  msg(

    playerState.mounted
      ? "Mounted."
      : "Dismounted."

  );

}


/* ==========================================
   PLAYER MOVEMENT
========================================== */

function movePlayer(
  dt
) {

  const forward =
    new THREE.Vector3(

      Math.sin(
        cameraYaw
      ),

      0,

      Math.cos(
        cameraYaw
      )

    );


  const right =
    new THREE.Vector3(

      forward.z,

      0,

      -forward.x

    );


  const move =
    new THREE.Vector3();


  if (
    keys.has("KeyW")
  )
    move.add(forward);


  if (
    keys.has("KeyS")
  )
    move.sub(forward);


  if (
    keys.has("KeyD")
  )
    move.add(right);


  if (
    keys.has("KeyA")
  )
    move.sub(right);


  const sprinting =

    keys.has(
      "ShiftLeft"
    ) &&

    playerState.stamina >
      0;


  const speed =

    playerState.mounted
      ? 16

      : sprinting
        ? 12
        : 7;


  if (
    move.lengthSq()
  ) {

    move.normalize();


    player.position
      .addScaledVector(

        move,

        speed *
        dt

      );


    player.rotation.y =

      Math.atan2(

        move.x,

        move.z

      );


    if (
      sprinting
    ) {

      playerState.stamina =

        Math.max(

          0,

          playerState.stamina -
          24 * dt

        );

    }

  } else {

    playerState.stamina =

      Math.min(

        100,

        playerState.stamina +
        17 * dt

      );

  }


  if (

    playerState.mounted &&

    keys.has("Space")

  ) {

    player.position.y +=
      8 *
      dt;

  }


  else if (

    playerState.mounted &&

    keys.has(
      "ControlLeft"
    )

  ) {

    player.position.y -=
      8 *
      dt;

  }


  else {

    player.position.y =

      terrainHeight(

        player.position.x,

        player.position.z

      );

  }


  player.position.x =

    THREE.MathUtils.clamp(

      player.position.x,

      -430,

      430

    );


  player.position.z =

    THREE.MathUtils.clamp(

      player.position.z,

      -430,

      430

    );


  if (
    playerState.summon
  ) {

    const target =

      player.position
        .clone()

        .add(

          right
            .clone()
            .multiplyScalar(
              3
            )

        )

        .add(

          forward
            .clone()
            .multiplyScalar(
              -3
            )

        );


    playerState.summon.position
      .lerp(

        target,

        1 -
        Math.exp(
          -4 * dt
        )

      );


    playerState.summon.position.y =

      Math.max(

        playerState.summon.position.y,

        terrainHeight(

          playerState.summon.position.x,

          playerState.summon.position.z

        )

      );

  }

}


/* ==========================================
   CAMERA
========================================== */

function updateCamera() {

  const distance =
    8.5;


  const height =
    4.3;


  const focus =

    player.position
      .clone()
      .add(

        new THREE.Vector3(
          0,
          2.2,
          0
        )

      );


  const offset =
    new THREE.Vector3(

      -Math.sin(
        cameraYaw
      ) *

      Math.cos(
        cameraPitch
      ) *

      distance,


      height +

      Math.sin(
        -cameraPitch
      ) *

      distance,


      -Math.cos(
        cameraYaw
      ) *

      Math.cos(
        cameraPitch
      ) *

      distance

    );


  camera.position.lerp(

    focus
      .clone()
      .add(
        offset
      ),

    0.16

  );


  camera.lookAt(
    focus
  );

}


/* ==========================================
   DAY AND NIGHT
========================================== */

function updateDayNight(
  dt
) {

  dayTime =

    (
      dayTime +
      dt * 0.18
    ) %

    24;


  const phase =

    dayTime /
    24 *

    Math.PI *
    2;


  const daylight =

    THREE.MathUtils.clamp(

      Math.sin(

        phase -
        Math.PI / 2

      ) *

      0.65 +

      0.5,

      0.12,

      1

    );


  sun.intensity =

    0.5 +

    daylight *
    2.2;


  sun.position.set(

    Math.cos(
      phase
    ) * 180,

    Math.sin(
      phase
    ) * 180,

    80

  );


  const sky =
    new THREE.Color()
      .lerpColors(

        new THREE.Color(
          0x10213d
        ),

        new THREE.Color(
          0x86bde8
        ),

        daylight

      );


  scene.background.copy(
    sky
  );


  if (
    clockText
  ) {

    clockText.textContent =

      `${String(
        Math.floor(
          dayTime
        )
      ).padStart(
        2,
        "0"
      )}:${String(
        Math.floor(
          (dayTime % 1) *
          60
        )
      ).padStart(
        2,
        "0"
      )}`;

  }

}


/* ==========================================
   ZONE NAME
========================================== */

function zoneForPlayer() {

  const biome =
    biomeAt(

      player.position.x,

      player.position.z

    );


  return ({

    grassland:
      "Emerald Plains",

    desert:
      "Sunscar Desert",

    snow:
      "Frost Crown",

    volcanic:
      "Ashen Reach",

    coast:
      "Azure Coast"

  })[biome];

}


/* ==========================================
   PARTY HUD
========================================== */

function renderParty() {

  if (
    !partyHud
  )
    return;


  partyHud.textContent =

    playerState.party.length

      ? playerState.party
          .map(

            (pal, index) =>

              `${index + 1}. ${pal.name} Lv.${pal.level}`

          )
          .join(
            "  •  "
          )

      : "Party empty";

}


/* ==========================================
   HUD
========================================== */

function updateHud() {

  playerState.food =

    Math.max(

      0,

      playerState.food -
      0.16 / 60

    );


  if (
    hpBar
  )
    hpBar.style.width =
      `${playerState.hp}%`;


  if (
    hpText
  )
    hpText.textContent =
      `${Math.round(
        playerState.hp
      )}/100`;


  if (
    staminaBar
  )
    staminaBar.style.width =
      `${playerState.stamina}%`;


  if (
    staminaText
  )
    staminaText.textContent =
      `${Math.round(
        playerState.stamina
      )}/100`;


  if (
    foodBar
  )
    foodBar.style.width =
      `${playerState.food}%`;


  if (
    foodText
  )
    foodText.textContent =
      `${Math.round(
        playerState.food
      )}/100`;


  if (
    levelText
  )
    levelText.textContent =
      `Lv. ${playerState.level}`;


  if (
    zoneName
  )
    zoneName.textContent =
      zoneForPlayer();


  if (
    sphereHud
  ) {

    sphereHud.textContent =

      `${selectedSphere + 1} • ${SPHERES[selectedSphere].name}` +

      (
        qHeld

          ? ` • Charge ${Math.round(
              qCharge * 100
            )}%`

          : ""
      );

  }

}


/* ==========================================
   INPUT
========================================== */

function bindInput() {

  addEventListener(

    "keydown",

    event => {

      keys.add(
        event.code
      );


      if (
        event.code.startsWith(
          "Digit"
        )
      ) {

        const number =
          Number(
            event.code.slice(
              5
            )
          );


        if (

          number >= 1 &&

          number <=
          SPHERES.length

        ) {

          selectedSphere =
            number - 1;

        }

      }


      if (

        event.code === "KeyQ" &&

        !event.repeat

      ) {

        qHeld = true;

        qCharge = 0;

      }


      if (

        event.code === "KeyF" &&

        !event.repeat

      ) {

        summonFirstPal();

      }


      if (

        event.code === "KeyE" &&

        !event.repeat

      ) {

        toggleMount();

      }


      if (
        event.code === "Escape"
      ) {

        toggleMenu();

      }

    }

  );


  addEventListener(

    "keyup",

    event => {

      keys.delete(
        event.code
      );


      if (
        event.code === "KeyQ"
      ) {

        qHeld = false;

        throwSphere();

      }

    }

  );


  canvas.addEventListener(

    "mousedown",

    event => {

      if (

        event.button === 0 &&

        !qHeld

      ) {

        attackTarget();

      }


      if (

        document.pointerLockElement !==
        canvas

      ) {

        canvas.requestPointerLock();

      }

    }

  );


  addEventListener(

    "mousemove",

    event => {

      if (

        document.pointerLockElement !==
        canvas

      )
        return;


      cameraYaw -=

        event.movementX *
        0.0022;


      cameraPitch =

        THREE.MathUtils.clamp(

          cameraPitch -

          event.movementY *
          0.0018,

          -0.72,

          0.48

        );

    }

  );

}


/* ==========================================
   MENU
========================================== */

function toggleMenu(
  force
) {

  paused =

    typeof force === "boolean"

      ? force

      : !paused;


  if (
    menuPanel
  ) {

    menuPanel.style.display =

      paused
        ? "flex"
        : "none";

  }


  if (

    paused &&

    document.pointerLockElement

  ) {

    document.exitPointerLock();

  }

}


menuButton?.addEventListener(

  "click",

  () =>
    toggleMenu()

);


resumeButton?.addEventListener(

  "click",

  () =>
    toggleMenu(
      false
    )

);


resetButton?.addEventListener(

  "click",

  () => {

    localStorage.removeItem(
      SAVE_KEY
    );

    location.reload();

  }

);


backButton?.addEventListener(

  "click",

  () =>
    history.back()

);


/* ==========================================
   RESIZE
========================================== */

addEventListener(

  "resize",

  () => {

    camera.aspect =

      innerWidth /
      innerHeight;


    camera.updateProjectionMatrix();


    renderer.setSize(

      innerWidth,

      innerHeight

    );

  }

);


/* ==========================================
   INITIALIZE GAME
========================================== */

async function init() {

  if (
    loading
  ) {

    loading.textContent =
      "Building GALAXY PALS world…";

  }


  createTerrain();

  createWater();

  createWorldProps();

  createSkyDecor();


  await loadPlayer();


  if (
    loading
  ) {

    loading.textContent =
      "Loading Pals…";

  }


  await loadPals();


  renderParty();

  bindInput();


  if (
    loading
  ) {

    loading.style.display =
      "none";

  }


  msg(
    "GALAXY PALS world ready."
  );


  setInterval(
    persist,
    5000
  );


  animate();

}


/* ==========================================
   GAME LOOP
========================================== */

function animate() {

  requestAnimationFrame(
    animate
  );


  const dt =

    Math.min(

      clock.getDelta(),

      0.05

    );


  if (
    !paused
  ) {

    if (
      qHeld
    ) {

      qCharge =

        Math.min(

          1,

          qCharge +
          dt / 1.2

        );

    }


    movePlayer(
      dt
    );


    updateWild(
      dt
    );


    updateSpheres(
      dt
    );


    updateCamera();


    updateTarget();


    updateDayNight(
      dt
    );


    updateHud();


    for (
      const mixer of mixers
    ) {

      mixer.update(
        dt
      );

    }

  }


  renderer.render(

    scene,

    camera

  );

}


/* ==========================================
   START
========================================== */

init()
  .catch(

    error => {

      console.error(
        error
      );


      if (
        loading
      ) {

        loading.textContent =
          "Game failed to load. Open browser console for details.";

      }

    }

  );
