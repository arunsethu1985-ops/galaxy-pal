/* ==========================================
   SAVE SYSTEM
========================================== */

function loadSave() {

  try {

    return (
      JSON.parse(
        localStorage.getItem(
          SAVE_KEY
        )
      ) || {}
    );

  } catch {

    return {};

  }

}

const save =
  loadSave();

const playerState = {

  hp:
    save.hp ?? 100,

  stamina:
    save.stamina ?? 100,

  food:
    save.food ?? 100,

  level:
    save.level ?? 1,

  party:
    save.party ?? [],

  box:
    save.box ?? [],

  mounted: false,

  summon: null

};

function persist() {

  localStorage.setItem(
    SAVE_KEY,
    JSON.stringify({

      hp:
        playerState.hp,

      stamina:
        playerState.stamina,

      food:
        playerState.food,

      level:
        playerState.level,

      party:
        playerState.party,

      box:
        playerState.box

    })
  );

}


/* ==========================================
   MESSAGE FEED
========================================== */

function msg(text) {

  if (!feed) return;

  const element =
    document.createElement("div");

  element.textContent =
    text;

  feed.prepend(
    element
  );

  while (
    feed.children.length > 5
  ) {

    feed.lastElementChild.remove();

  }

}


/* ==========================================
   MATERIAL HELPER
========================================== */

function makeMat(
  color,
  roughness = 0.85
) {

  return (
    new THREE.MeshStandardMaterial({

      color,

      roughness,

      metalness: 0.05

    })
  );

}


/* ==========================================
   MESH HELPER
========================================== */

function addMesh(
  geometry,
  material,
  x,
  y,
  z,
  sx = 1,
  sy = 1,
  sz = 1
) {

  const mesh =
    new THREE.Mesh(
      geometry,
      material
    );

  mesh.position.set(
    x,
    y,
    z
  );

  mesh.scale.set(
    sx,
    sy,
    sz
  );

  mesh.castShadow = true;

  mesh.receiveShadow = true;

  world.add(
    mesh
  );

  return mesh;

}


/* ==========================================
   TERRAIN HEIGHT
========================================== */

function terrainHeight(
  x,
  z
) {

  const broad =
    Math.sin(
      x * 0.013
    ) * 4 +

    Math.cos(
      z * 0.011
    ) * 4;

  const detail =
    Math.sin(
      (x + z) * 0.028
    ) * 1.7 +

    Math.cos(
      (x - z) * 0.021
    ) * 1.5;

  const mountain =
    Math.max(

      0,

      Math.sin(
        x * 0.006 + 1.7
      ) +

      Math.cos(
        z * 0.006 - 0.5
      ) -

      1.05

    ) * 22;

  return (
    broad +
    detail +
    mountain
  );

}


/* ==========================================
   BIOMES
========================================== */

function biomeAt(
  x,
  z
) {

  if (x > 210)
    return "desert";

  if (z < -220)
    return "snow";

  if (x < -230)
    return "volcanic";

  if (z > 230)
    return "coast";

  return "grassland";

}

function biomeColor(
  biome
) {

  return ({

    grassland:
      0x6eab50,

    desert:
      0xc9a65e,

    snow:
      0xe8f1f3,

    volcanic:
      0x403936,

    coast:
      0x8ab46a

  })[biome];

}


/* ==========================================
   CREATE TERRAIN
========================================== */

function createTerrain() {

  const size = 900;

  const segments = 170;

  const geometry =
    new THREE.PlaneGeometry(
      size,
      size,
      segments,
      segments
    );

  geometry.rotateX(
    -Math.PI / 2
  );

  const positions =
    geometry.attributes.position;

  const colors = [];

  const color =
    new THREE.Color();

  for (
    let i = 0;
    i < positions.count;
    i++
  ) {

    const x =
      positions.getX(i);

    const z =
      positions.getZ(i);

    const y =
      terrainHeight(
        x,
        z
      );

    positions.setY(
      i,
      y
    );

    const biome =
      biomeAt(
        x,
        z
      );

    color.setHex(
      biomeColor(
        biome
      )
    );

    const variation =

      (
        Math.sin(
          x * 0.12
        ) +

        Math.cos(
          z * 0.13
        )

      ) * 0.025;

    color.offsetHSL(
      0,
      0,
      variation
    );

    colors.push(
      color.r,
      color.g,
      color.b
    );

  }

  geometry.setAttribute(

    "color",

    new THREE.Float32BufferAttribute(
      colors,
      3
    )

  );

  geometry.computeVertexNormals();

  const material =
    new THREE.MeshStandardMaterial({

      vertexColors: true,

      roughness: 1

    });

  const terrain =
    new THREE.Mesh(
      geometry,
      material
    );

  terrain.receiveShadow = true;

  world.add(
    terrain
  );

}


/* ==========================================
   WATER
========================================== */

function createWater() {

  const water =
    new THREE.Mesh(

      new THREE.PlaneGeometry(
        1100,
        1100
      ),

      new THREE.MeshPhysicalMaterial({

        color:
          0x4aa7d8,

        transparent:
          true,

        opacity:
          0.72,

        roughness:
          0.18,

        metalness:
          0.05

      })

    );

  water.rotation.x =
    -Math.PI / 2;

  water.position.y =
    -4.7;

  world.add(
    water
  );


  const lake =
    new THREE.Mesh(

      new THREE.CircleGeometry(
        70,
        64
      ),

      new THREE.MeshPhysicalMaterial({

        color:
          0x2f89c2,

        transparent:
          true,

        opacity:
          0.8,

        roughness:
          0.12

      })

    );

  lake.rotation.x =
    -Math.PI / 2;

  lake.position.set(

    40,

    terrainHeight(
      40,
      60
    ) + 0.6,

    60

  );

  world.add(
    lake
  );

}


/* ==========================================
   TREES
========================================== */

function createTree(
  x,
  z,
  snowy = false
) {

  const y =
    terrainHeight(
      x,
      z
    );

  addMesh(

    new THREE.CylinderGeometry(
      0.6,
      0.95,
      6,
      7
    ),

    makeMat(
      0x76533b
    ),

    x,

    y + 3,

    z

  );


  const crownColor =
    snowy
      ? 0xd9edf0
      : 0x2f7c43;


  for (
    let i = 0;
    i < 3;
    i++
  ) {

    const crown =
      addMesh(

        new THREE.ConeGeometry(
          3.4 - i * 0.45,
          5.5,
          9
        ),

        makeMat(
          crownColor
        ),

        x,

        y + 6 + i * 2.2,

        z

      );

    crown.rotation.y =
      Math.random() *
      Math.PI;

  }

}


/* ==========================================
   ROCKS
========================================== */

function createRock(
  x,
  z,
  volcanic = false
) {

  const y =
    terrainHeight(
      x,
      z
    );

  const rock =
    addMesh(

      new THREE.DodecahedronGeometry(
        1.8,
        0
      ),

      makeMat(
        volcanic
          ? 0x2d2725
          : 0x71777c
      ),

      x,

      y + 1.2,

      z,

      0.8 +
        Math.random() * 1.8,

      0.6 +
        Math.random() * 1.8,

      0.8 +
        Math.random() * 1.8

    );

  rock.rotation.set(

    Math.random(),

    Math.random(),

    Math.random()

  );

}


/* ==========================================
   WORLD OBJECTS
========================================== */

function createWorldProps() {

  for (
    let i = 0;
    i < 180;
    i++
  ) {

    const x =
      THREE.MathUtils.randFloatSpread(
        820
      );

    const z =
      THREE.MathUtils.randFloatSpread(
        820
      );

    const biome =
      biomeAt(
        x,
        z
      );


    if (

      biome === "grassland" ||

      biome === "coast" ||

      biome === "snow"

    ) {

      if (
        Math.random() < 0.62
      ) {

        createTree(
          x,
          z,
          biome === "snow"
        );

      } else {

        createRock(
          x,
          z
        );

      }

    }


    else if (
      biome === "desert"
    ) {

      createRock(
        x,
        z
      );

      if (
        Math.random() < 0.25
      ) {

        const y =
          terrainHeight(
            x,
            z
          );

        const cactus =
          addMesh(

            new THREE.CylinderGeometry(
              0.45,
              0.6,
              4.5,
              8
            ),

            makeMat(
              0x5d8b4f
            ),

            x,

            y + 2.25,

            z

          );

        cactus.rotation.z =
          THREE.MathUtils.randFloatSpread(
            0.2
          );

      }

    }


    else {

      createRock(
        x,
        z,
        true
      );

    }

  }


  /* ANCIENT RUINS */

  for (
    let i = 0;
    i < 8;
    i++
  ) {

    const angle =
      i / 8 *
      Math.PI *
      2;

    const x =
      -40 +
      Math.cos(
        angle
      ) * 24;

    const z =
      30 +
      Math.sin(
        angle
      ) * 24;

    const y =
      terrainHeight(
        x,
        z
      );

    addMesh(

      new THREE.BoxGeometry(
        3,
        12,
        3
      ),

      makeMat(
        0x9a9688
      ),

      x,

      y + 6,

      z

    );

  }


  /* BOSS ARENA */

  const ring =
    new THREE.Mesh(

      new THREE.TorusGeometry(
        24,
        1.2,
        10,
        48
      ),

      makeMat(
        0x625b52
      )

    );

  ring.rotation.x =
    Math.PI / 2;

  ring.position.set(

    150,

    terrainHeight(
      150,
      -40
    ) + 0.8,

    -40

  );

  world.add(
    ring
  );


  /* VOLCANO */

  const volcano =
    new THREE.Mesh(

      new THREE.ConeGeometry(
        50,
        85,
        40,
        8,
        true
      ),

      makeMat(
        0x372d2a
      )

    );

  volcano.position.set(

    -330,

    terrainHeight(
      -330,
      80
    ) + 38,

    80

  );

  volcano.castShadow =
    true;

  world.add(
    volcano
  );


  const lava =
    new THREE.Mesh(

      new THREE.CircleGeometry(
        18,
        40
      ),

      new THREE.MeshStandardMaterial({

        color:
          0xff5b18,

        emissive:
          0xff2600,

        emissiveIntensity:
          2

      })

    );

  lava.rotation.x =
    -Math.PI / 2;

  lava.position.set(

    -330,

    volcano.position.y + 42,

    80

  );

  world.add(
    lava
  );

}


